# Copy to .env (git-ignored) to deploy to Sepolia with real Chainlink VRF. Local work needs none of this.
# See docs/vrf.md for the full walkthrough.

# HTTPS RPC endpoint for Sepolia (Alchemy, Infura, etc.)
SEPOLIA_RPC_URL=
# Private key of a throwaway deployer wallet funded with Sepolia ETH. Never use a wallet with real funds.
DEPLOYER_PRIVATE_KEY=

# Your VRF v2.5 subscription id from https://vrf.chain.link (Sepolia), funded with LINK or Sepolia ETH.
VRF_SUBSCRIPTION_ID=
# Optional overrides. Defaults are Chainlink's Sepolia VRF v2.5 coordinator and key hash.
# VRF_COORDINATOR=0x9DdfaCa8183c41ad55329BdeeD9F6A8d53168B1B
# VRF_KEY_HASH=0x787d74caea10b2b357790d5b5247c2f63d1d91572a9846f780606e4d953677ae
# Pay for requests in Sepolia ETH instead of LINK.
# VRF_NATIVE_PAYMENT=false
# VRF_CALLBACK_GAS_LIMIT=1000000
